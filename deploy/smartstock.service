# systemd service: keeps SmartStock running on a Linux server and restarts it if it crashes.
# Install (as root), assuming the project is in /opt/smartstock and runs as user "smartstock":
#     sudo cp deploy/smartstock.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now smartstock
# See its output with:  journalctl -u smartstock -f
[Unit]
Description=SmartStock (Adlers vending stock dashboard)
After=network.target mysql.service

[Service]
User=smartstock
Group=smartstock
WorkingDirectory=/opt/smartstock
EnvironmentFile=/opt/smartstock/.env
ExecStart=/opt/smartstock/venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
