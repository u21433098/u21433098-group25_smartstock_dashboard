# Copy this file to ".env" and change the values. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
APP_CONFIG=development
FLASK_APP=run.py

# MySQL connection: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://smartstock:change-me@localhost:3306/smartstock

# Optional: run the tests against a SEPARATE MySQL database (tests wipe it).
# Leave it out to run the tests on an in-memory SQLite database instead.
# TEST_DATABASE_URL=mysql+pymysql://smartstock:change-me@localhost:3306/smartstock_test
